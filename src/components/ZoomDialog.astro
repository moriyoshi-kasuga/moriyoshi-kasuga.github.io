<span class="zoom-wrapper contents">
  <button
    class="zoom-trigger cursor-zoom-in border-none bg-transparent p-0"
    type="button"
    aria-label="画像を拡大表示"
  >
    <slot />
  </button>
  <dialog class="zoom-dialog" aria-label="拡大画像表示">
    <button
      class="zoom-close absolute top-4 right-4 -translate-x-1/2 flex size-10 items-center justify-center rounded-full bg-primary text-3xl text-white transition-colors hover:bg-primary-foreground focus:ring-2 focus:ring-primary-foreground focus:ring-offset-2"
      aria-label="閉じる"
      type="button"
    >
      ×
    </button>
    <div
      class="zoom-content max-w-4xl scale-110 transition-transform duration-300"
    >
    </div>
  </dialog>
</span>

<style>
  .zoom-dialog {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: 100vw;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: none;
    background: rgba(255, 255, 255, 0.8);
    -webkit-backdrop-filter: blur(0.25rem);
    backdrop-filter: blur(0.25rem);
    box-shadow:
      0 10px 15px -3px rgb(0 0 0 / 0.1),
      0 4px 6px -4px rgb(0 0 0 / 0.1);
    display: none;
    align-items: center;
    justify-content: center;
  }

  .zoom-dialog[open] {
    display: flex;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    document
      .querySelectorAll<HTMLElement>(".zoom-wrapper")
      .forEach((wrapper) => {
        const trigger = wrapper.querySelector<HTMLButtonElement>(".zoom-trigger");
        const dialog = wrapper.querySelector<HTMLDialogElement>(".zoom-dialog");
        const closeBtn = wrapper.querySelector<HTMLButtonElement>(".zoom-close");
        const content = wrapper.querySelector<HTMLDivElement>(".zoom-content");

        if (!trigger || !dialog || !closeBtn || !content) return;

        if (!content.firstElementChild && trigger.firstElementChild) {
          content.appendChild(trigger.firstElementChild.cloneNode(true));
        }

        trigger.addEventListener("click", () => dialog.showModal());
        closeBtn.addEventListener("click", () => dialog.close());
        dialog.addEventListener("click", (e) => {
          if (e.target === dialog) dialog.close();
        });
      });
  });
</script>
