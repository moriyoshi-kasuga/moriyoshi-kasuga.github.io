---
interface Props {
  href?: string;
  id: string;
  value: string;
}

const { href, id, value } = Astro.props;
---

<div class="flex-items-gap w-full">
  <h2 class="item-label">
    {id}
  </h2>
  {
    href
? (
      <a
        href={href}
        class="link-style item-value"
        target="_blank"
      >
        {value}
      </a>
    )
: (
      <p class="item-value">
        {value}
      </p>
    )
  }
</div>
