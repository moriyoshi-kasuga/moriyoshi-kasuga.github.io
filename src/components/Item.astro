---
interface Props {
  href?: string;
  value: string;
  skillIcon?: string;
}

const { href, value, skillIcon } = Astro.props;

const iconURL = skillIcon
  ? `https://go-skill-icons.vercel.app/api/icons?i=${skillIcon}`
  : undefined;
---

<div>
  {
    iconURL && (
      <img src={iconURL} alt={value} class="inline-block -mr-1 size-[25px]" />
    )
  }
  {
    href ? (
      <a href={href} class="link-style font-normal" target="_blank">
        {value}
      </a>
    ) : (
      <p>{value}</p>
    )
  }
</div>
