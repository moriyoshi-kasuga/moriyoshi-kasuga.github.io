---
interface Props {
  title: string;
  class?: string;
  alwaysCenter?: boolean;
}

const { title, class: className, alwaysCenter } = Astro.props;
---

<div
  class:list={[
    "flex w-full items-center sm:flex-row",
    alwaysCenter ? "gap-4" : "flex-col sm:gap-4",
  ]}
>
  <h2
    class:list={[
      "text-2xl font-bold",
      alwaysCenter
        ? "max-w-1/2 min-w-1/2 text-right"
        : "sm:max-w-1/3 sm:min-w-1/3 sm:text-right lg:max-w-1/2 lg:min-w-1/2",
    ]}
  >
    {title}
  </h2>
  <div
    class:list={[
      "flex flex-wrap gap-4 text-left text-semibold-xl wrap-break-word",
      className,
    ]}
  >
    <slot />
  </div>
</div>
