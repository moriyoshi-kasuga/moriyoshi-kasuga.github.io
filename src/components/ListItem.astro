---
interface Props {
  title: string;
  alwaysCenter?: boolean;
}

const { title, alwaysCenter } = Astro.props;
---

<div
  class:list={[
    "flex w-full items-center sm:flex-row",
    alwaysCenter ? "gap-2" : "flex-col sm:gap-2",
  ]}
>
  <h2
    class:list={[
      "text-2xl font-bold",
      alwaysCenter
        ? "max-w-1/2 min-w-1/2 text-right"
        : "sm:max-w-1/3 sm:min-w-1/3 sm:text-right lg:max-w-1/2 lg:min-w-1/2",
    ]}
  >
    {title}
  </h2>
  <div
    class="flex flex-wrap gap-2 text-left text-xl font-semibold wrap-break-word"
  >
    <slot />
  </div>
</div>
