---
interface Props {
  title: string;
  class?: string;
  alwaysCenter?: boolean;
}

const { title, class: className, alwaysCenter } = Astro.props;
---

<div
  class:list={[
    "flex items-center w-full sm:flex-row",
    alwaysCenter ? "gap-4" : "sm:gap-4 flex-col",
  ]}
>
  <h2
    class={`text-2xl font-bold ${alwaysCenter ? "min-w-1/2 max-w-1/2 text-right" : "sm:min-w-1/3 sm:max-w-1/3 sm:text-right lg:min-w-1/2 lg:max-w-1/2"}`}
  >
    {title}
  </h2>
  <div
    class={`text-left text-xl font-semibold break-words gap-4 flex flex-wrap ${className || ""}`}
  >
    <slot />
  </div>
</div>
