---
interface Props {
  url: string;
  self?: boolean;
  class?: string;
}

const { url, self, class: className } = Astro.props;
---

<a
  href={url}
  target={self ? "_self" : "_blank"}
  class:list={[
    "flex-items-gap rounded-lg bg-gray-800 p-2 text-2xl text-white hover-scale focus:ring-2 focus:ring-offset-2 focus:ring-gray-400",
    className,
  ]}
  rel={self ? undefined : "noopener noreferrer"}
>
  <slot name="icon" />
  <span class="font-medium text-gray-100"><slot /></span>
</a>
