---
import MobileMenu from "@components/MobileMenu.astro";
import Mori from "@src/assets/mori.png";
import { MAIN_NAV } from "@src/constants/navigation";
import { isCurrentSection } from "@src/lib/navigation";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
---

<header
  class="fixed top-0 z-50 flex h-(--header-height) w-screen items-center px-4 py-2 before:absolute before:inset-0 before:backdrop-blur-xs"
>
  <nav
    class="relative container mx-auto flex items-center justify-between"
    aria-label="メインナビゲーション"
  >
    <a
      href="/"
      class="absolute left-1/2 aspect-square h-[calc(var(--header-height)*0.8)] -translate-x-1/2 hover-scale [--scale-amount:1.1] md:left-auto"
      aria-label="ホームに戻る"
    >
      <Image src={Mori} alt="My Avatar" class="rounded-full object-cover" />
    </a>

    <!-- デスクトップナビゲーション -->
    <div
      class="ml-auto hidden items-center space-x-6 text-xl font-semibold md:flex"
    >
      {
        MAIN_NAV.map(({ href, label, icon }) => (
          <a
            href={href}
            class="link-hover-animation"
            aria-current={
              isCurrentSection(Astro.url.pathname, href) ? "page" : undefined
            }
          >
            <Icon name={icon} aria-hidden="true" />
            <span>{label}</span>
          </a>
        ))
      }
    </div>

    <!-- モバイルナビゲーション -->
    <div class="ml-auto flex items-center md:hidden">
      <MobileMenu />
    </div>
  </nav>
</header>
