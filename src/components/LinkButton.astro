---
export type LinkButtonVariant = "dark" | "outline" | "primary" | "success" | "warning" | "danger";

interface Props {
  url?: string;
  variant?: LinkButtonVariant;
  self?: boolean;
  class?: string;
}

const VARIANT_CLASS: Record<LinkButtonVariant, string> = {
  dark: "flex-items-gap rounded-lg bg-gray-800 p-2 text-2xl text-white hover-scale focus:ring-2 focus:ring-offset-2 focus:ring-gray-400",
  outline: "btn ring-2 ring-black hover:text-white",
  primary: "btn-primary",
  success: "btn-success",
  warning: "btn-warning",
  danger: "btn-danger",
};

const { url, variant = "outline", self, class: className } = Astro.props;
---

{
  url
    ? (
        <a
          href={url}
          target={self ? "_self" : "_blank"}
          rel={self ? undefined : "noopener noreferrer"}
          class:list={[VARIANT_CLASS[variant], className]}
        >
          <slot name="icon" />
          <span><slot /></span>
        </a>
      )
    : (
        <div class:list={["base-btn cursor-not-allowed bg-gray-400 line-through", className]}>
          <slot name="icon" />
          <span><slot /></span>
        </div>
      )
}
