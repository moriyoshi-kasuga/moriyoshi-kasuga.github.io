---
export type LinkButtonVariant =
  "dark" | "outline" | "primary" | "success" | "warning" | "danger";

interface Props {
  url?: string;
  variant?: LinkButtonVariant;
  self?: boolean;
  ariaLabel?: string;
}

const VARIANT_CLASS: Record<LinkButtonVariant, string> = {
  dark: "flex items-center gap-2 rounded-lg bg-gray-800 p-2 text-2xl text-white hover-scale focus:ring-2 focus:ring-gray-400 focus:ring-offset-2",
  outline:
    "btn text-zinc-900 ring-2 ring-black hover:bg-zinc-900 hover:text-white",
  primary:
    "btn bg-primary-300 text-gray-900 hover:bg-gray-900 hover:text-primary-500",
  success:
    "btn bg-success-300 text-gray-900 hover:bg-gray-900 hover:text-success-500",
  warning:
    "btn bg-warning-300 text-gray-900 hover:bg-gray-900 hover:text-warning-500",
  danger:
    "btn bg-danger-300 text-gray-900 hover:bg-gray-900 hover:text-danger-500",
};

const { url, variant = "outline", self, ariaLabel } = Astro.props;
---

{
  url ? (
    <a
      href={url}
      target={self ? "_self" : "_blank"}
      rel={self ? undefined : "noopener noreferrer"}
      aria-label={ariaLabel}
      class={VARIANT_CLASS[variant]}
    >
      <slot name="icon" />
      <span>
        <slot />
      </span>
    </a>
  ) : (
    <div class="btn cursor-not-allowed bg-gray-400 line-through">
      <slot name="icon" />
      <span>
        <slot />
      </span>
    </div>
  )
}
