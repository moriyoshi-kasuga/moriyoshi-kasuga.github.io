---
import { Icon } from "astro-icon/components";
import Layout from "./Layout.astro";

interface Props {
  title: string;
  class: string;
}

const { title, class: className } = Astro.props;
const pathname = Astro.url.pathname;

function other(url: string) {
  if (pathname === url) {
    return false;
  }
  return pathname !== `${url}/`;
}
---

<Layout title={title}>
  <div class="min-h-all top-level-container flex flex-col items-center">
    <h1
      class:list={["flex items-center gap-x-2 text-5xl font-bold", className]}
    >
      <slot name="icon" />
      {title}
    </h1>
    <div class="font-monospace mt-10 mb-5 flex gap-8 max-md:flex-col">
      {
        other("/about") && (
          <a href="/about" class="btn bg-warning hover:text-warning-foreground">
            <Icon name="mdi:search" />
            About
          </a>
        )
      }
      {
        other("/about/likes") && (
          <a
            href="/about/likes"
            class="btn bg-danger hover:text-danger-foreground"
          >
            <Icon name="mdi:like-outline" />
            Likes
          </a>
        )
      }
      {
        other("/about/links") && (
          <a
            href="/about/links"
            class="btn bg-success hover:text-success-foreground"
          >
            <Icon name="mdi:notebook-outline" />
            Links
          </a>
        )
      }
      {
        other("/about/skill") && (
          <a
            href="/about/skill"
            class="btn bg-primary hover:text-primary-foreground"
          >
            <Icon name="mdi:computer" />
            Skill
          </a>
        )
      }
    </div>
    <slot />
  </div>
</Layout>
