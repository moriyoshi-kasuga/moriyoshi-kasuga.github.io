---
import LinkButton from "@components/LinkButton.astro";
import Layout from "@layouts/Layout.astro";
import { ABOUT_NAV } from "@src/constants/navigation";
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
}

const { title } = Astro.props;
const pathname = Astro.url.pathname;
const isCurrentPage = (href: string) =>
  pathname === href || pathname === `${href}/`;
const current = ABOUT_NAV.find(({ href }) => isCurrentPage(href));
---

<Layout title={title}>
  <div
    class="flex min-h-all w-full flex-col items-center lg:pl-[calc(100vw-100%)]"
  >
    <h1
      class:list={[
        "flex items-center gap-2 text-5xl font-bold",
        current?.headingClass,
      ]}
    >
      <slot name="icon" />
      {title}
    </h1>
    <div class="mt-10 mb-5 flex flex-row flex-wrap justify-center gap-8">
      {
        ABOUT_NAV.filter(({ href }) => !isCurrentPage(href)).map(
          ({ href, label, icon, variant }) => (
            <LinkButton url={href} variant={variant} self>
              <Icon name={icon} slot="icon" />
              {label}
            </LinkButton>
          ),
        )
      }
    </div>
    <slot />
  </div>
</Layout>
