---
import type { ImageMetadata } from "astro";
import type { Project } from "../type";
import IconButton from "@components/IconButton.astro";
import Mori from "@src/assets/mori.png";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { rawContent as SelfIntroduction } from "../static/self-introduction.md";
import { sortProjects } from "./projects/index.astro";

const projectFiles = import.meta.glob<{ frontmatter: Project }>(
  "../static/projects/*.md",
  { eager: true },
);
const showProjects = Object.values(projectFiles).sort(sortProjects).slice(0, 3);

const photos = import.meta.glob<{ default: ImageMetadata }>(
  `/src/assets/projects/*/main.png`,
  {
    eager: true,
  },
);
---

<Layout title="MoriLab">
  <div class="min-h-all bg-primary full-width-col-center text-white">
    <div class="flex flex-col items-center">
      <h1 class="text-responsive-display font-semibold">MoriLab</h1>
      <h2 class="text-3xl">Mori’s tiny dev lab.</h2>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-2 px-4">
        <IconButton url="https://github.com/moriyoshi-kasuga">
          <Icon name="mdi:github" slot="icon" />
          Github
        </IconButton>
        <IconButton
          url="https://github.com/moriyoshi-kasuga/moriyoshi-kasuga.github.io"
        >
          <Icon name="mdi:source-branch" slot="icon" />
          Repository
        </IconButton>
        <IconButton url="https://twitter.com/MoriyoshiKasuga">
          <Icon name="mdi:twitter" slot="icon" />
          旧Twitter
        </IconButton>
      </div>
      <div class="container mt-10 flex max-w-[1200px] flex-wrap">
        <h2 class="mb-10 w-full text-center text-5xl font-medium">Projects</h2>
        <div
          class="mx-auto flex flex-wrap lg:flex-nowrap items-center justify-center"
        >
          {
            showProjects.map((project) => {
              const p = project.frontmatter.name;
              return (
                <a
                  href={`/projects/${p}`}
                  class="group size-50"
                  aria-label={`プロジェクト ${project.frontmatter.title} の詳細を見る`}
                >
                  <div class="mx-4 my-2 flex flex-col items-center justify-center rounded-2xl">
                    <Image
                      src={photos[`/src/assets/projects/${p}/main.png`].default}
                      alt={`${p} image`}
                      class="aspect-square rounded-lg"
                      width={160}
                      height={160}
                      fetchpriority="high"
                      widths={[160, 320]}
                      sizes="160px"
                    />
                    <p class="font-monospace relative text-lg font-medium text-nowrap transition-all group-hover:scale-110 before:absolute before:-left-3 group-hover:before:content-['>'] after:absolute group-hover:after:content-['<'] md:text-xl">
                      {project.frontmatter.pin && (
                        <Icon
                          name="mdi:pin"
                          class="inline-block text-danger"
                          title="ピン留めされたプロジェクト"
                        />
                      )}
                      {project.frontmatter.title}
                    </p>
                  </div>
                </a>
              );
            })
          }
          <div class="flex flex-col items-center justify-center w-50 h-20">
            <div class="flex items-center justify-center">
              <a href="/projects" aria-label="すべてのプロジェクトを見る">
                <div
                  class="bg-danger hover:text-danger flex rounded-xl px-4 py-3 font-medium text-black smooth-transition hover:bg-black focus:ring-2 focus:ring-offset-2 focus:ring-danger-foreground"
                >
                  もっと見る!
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="my-8 flex w-2/3 flex-col items-center justify-center">
      <h2 class="mb-2 w-full text-center text-5xl font-bold">About</h2>
      <div
        class="flex gap-2 flex-wrap items-center justify-center gap-x-3 md:flex-nowrap"
      >
        <Image
          src={Mori}
          alt="Avatar"
          class="aspect-square rounded-full"
          width={150}
          height={150}
        />
        <div>
          <p
            class="measure-base font-semibold text-primary text-white text-responsive-lg line-loose"
          >
            {SelfIntroduction()}
          </p>
          <div class="mt-5 flex items-center justify-center">
            <a href="/about" aria-label="プロフィール詳細を見る">
              <div
                class="bg-warning hover:text-warning flex rounded-xl px-4 py-3 font-medium text-black smooth-transition hover:bg-black focus:ring-2 focus:ring-offset-2 focus:ring-warning-foreground"
              >
                もっと知る!
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
