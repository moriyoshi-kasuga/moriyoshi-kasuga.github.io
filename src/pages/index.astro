---
import LinkButton from "@components/LinkButton.astro";
import Mori from "@src/assets/mori.png";
import { SOCIAL_LINKS } from "@src/constants/metadata";
import { getFeaturedProjects } from "@src/lib/projects";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { rawContent as SelfIntroduction } from "../static/self-introduction.md";

const featuredProjects = await getFeaturedProjects(3);
---

<Layout title="MoriLab">
  <div class="min-h-all bg-primary full-width-col-center text-white">
    <div class="flex flex-col items-center">
      <h1 class="text-responsive-display font-semibold">MoriLab</h1>
      <h2 class="text-3xl">Mori’s tiny dev lab.</h2>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-2 px-4">
        <LinkButton url={SOCIAL_LINKS.github} variant="dark">
          <Icon name="mdi:github" slot="icon" />
          GitHub
        </LinkButton>
        <LinkButton url={SOCIAL_LINKS.repository} variant="dark">
          <Icon name="mdi:source-branch" slot="icon" />
          Repository
        </LinkButton>
        <LinkButton url={SOCIAL_LINKS.twitter} variant="dark">
          <Icon name="mdi:twitter" slot="icon" />
          旧Twitter
        </LinkButton>
      </div>
      <div class="container mt-10 flex max-w-[1200px] flex-wrap">
        <h2 class="mb-10 w-full text-center text-5xl font-medium">Projects</h2>
        <div
          class="mx-auto flex flex-wrap lg:flex-nowrap items-center justify-center"
        >
          {
            featuredProjects.map(project => (
              <a
                href={`/projects/${project.id}`}
                class="group size-50"
                aria-label={`プロジェクト ${project.data.title} の詳細を見る`}
              >
                <div class="mx-4 my-2 flex flex-col items-center justify-center rounded-2xl">
                  <Image
                    loading="lazy"
                    src={project.data.gallery[0]}
                    alt={`${project.data.title} image`}
                    class="aspect-square rounded-lg"
                    width={160}
                    height={160}
                    fetchpriority="high"
                    widths={[160, 320]}
                    sizes="160px"
                  />
                  <p class="relative text-lg font-medium text-nowrap transition-all group-hover:scale-110 before:absolute before:-left-3 group-hover:before:content-['>'] after:absolute group-hover:after:content-['<'] md:text-xl">
                    {project.data.pin && (
                      <Icon
                        name="mdi:pin"
                        class="inline-block text-danger"
                        title="ピン留めされたプロジェクト"
                      />
                    )}
                    {project.data.title}
                  </p>
                </div>
              </a>
            ))
          }
          <div class="flex w-50 items-center justify-center">
            <LinkButton url="/projects" variant="danger" self ariaLabel="すべてのプロジェクトを見る">
              もっと見る
            </LinkButton>
          </div>
        </div>
      </div>
    </div>
    <div class="my-8 flex w-2/3 flex-col items-center justify-center">
      <h2 class="mb-2 w-full text-center text-5xl font-bold">About</h2>
      <div
        class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 md:flex-nowrap"
      >
        <Image
          loading="lazy"
          src={Mori}
          alt="Avatar"
          class="aspect-square rounded-full"
          width={150}
          height={150}
        />
        <div>
          <p
            class="measure-base font-semibold text-white text-responsive-lg line-loose"
          >
            {SelfIntroduction()}
          </p>
          <div class="mt-5 flex items-center justify-center">
            <LinkButton url="/about" variant="warning" self ariaLabel="プロフィール詳細を見る">
              もっと知る
            </LinkButton>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
