---
import List from "@components/List.astro";
import ListItem from "@components/ListItem.astro";
import AboutLayout from "@layouts/AboutLayout.astro";
import Item from "@src/components/Item.astro";
import { Icon } from "astro-icon/components";
import { rawContent as SelfDescription } from "../../static/self-description.md";
---

<AboutLayout title="About" class="text-warning">
  <Icon name="mdi:search" slot="icon" />
  <List>
    <ListItem title="名前" alwaysCenter>
      <Item value="Mori" />
    </ListItem>
    <ListItem title="年齢" alwaysCenter>
      <Item value="18歳" />
    </ListItem>
    <ListItem title="誕生日" alwaysCenter>
      <Item value="2007/12/18" />
    </ListItem>
  </List>
  <p
    class="my-2 py-2 rounded-lg border container md:w-3/5 font-semibold text-primary text-responsive-lg line-loose measure-base"
  >
    {SelfDescription()}
  </p>
  <div class="container pt-2 stats-grid mb-10">
    <div class="relative h-[150px] rounded-xs">
      <img
        alt="Github Stats"
        src="https://github-readme-stats.vercel.app/api?username=moriyoshi-kasuga&theme=onedark&show_icons=true"
        class="object-fit aspect-auto h-[150px]"
        height="100%"
      />
    </div>

    <div
      class="relative order-none h-[200px] rounded-xs md:order-1 md:max-lg:col-span-2 lg:order-none"
    >
      <img
        alt="Top Langs"
        src="https://github-readme-stats.vercel.app/api/top-langs/?username=moriyoshi-kasuga&layout=compact&show_icons=true&theme=onedark"
        class="object-fit aspect-auto h-[200px]"
        height="100%"
      />
    </div>

    <div class="relative h-[150px] rounded-xs">
      <img
        alt="Github Streak"
        src="https://streak-stats.demolab.com?user=moriyoshi-kasuga&theme=onedark"
        class="object-fit aspect-auto h-[150px]"
        height="100%"
      />
    </div>
  </div>
</AboutLayout>
