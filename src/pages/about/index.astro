---
import Item from "@components/Item.astro";
import List from "@components/List.astro";
import AboutLayout from "@layouts/AboutLayout.astro";
import { Icon } from "astro-icon/components";
import { rawContent as SelfDescription } from "../../static/self-description.md";
---

<AboutLayout title="About" color="text-warning">
  <Icon name="mdi:search" slot="icon" />
  <List>
    <Item id="名前" value="Mori" />
    <Item id="年齢" value="17" />
    <Item id="誕生日" value="2007/12/18" />
    <Item id="言語" value="Python・JavaScript・TypeScript・Java" />
    <Item id="ツール" value="WSL2,macOs,Neovim" />
  </List>
  <p
    class="my-2 py-2 rounded-lg border container md:w-3/5 font-semibold font-mono sm:text-lg md:text-xl"
  >
    {SelfDescription()}
  </p>
  <div
    class="container pt-2 grid h-[600px] grid-cols-1 place-items-center items-center justify-center gap-1 md:h-[400px] md:grid-cols-2 lg:h-[200px] lg:grid-cols-3"
  >
    <div class="relative h-[150px] rounded-xs">
      <img
        alt="Github Stats"
        src="https://github-readme-stats.vercel.app/api?username=moriyoshi-kasuga&theme=onedark&show_icons=true"
        class="object-fit aspect-auto h-[150px]"
        height="100%"
      />
    </div>

    <div
      class="relative order-none h-[200px] rounded-xs md:order-1 md:max-lg:col-span-2 lg:order-none"
    >
      <img
        alt="Top Langs"
        src="https://github-readme-stats.vercel.app/api/top-langs/?username=moriyoshi-kasuga&layout=compact&show_icons=true&theme=onedark"
        class="object-fit aspect-auto h-[200px]"
        height="100%"
      />
    </div>

    <div class="relative h-[150px] rounded-xs">
      <img
        alt="Github Streak"
        src="https://streak-stats.demolab.com?user=moriyoshi-kasuga&theme=onedark"
        class="object-fit aspect-auto h-[150px]"
        height="100%"
      />
    </div>
  </div>
</AboutLayout>
