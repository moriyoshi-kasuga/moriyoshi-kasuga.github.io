---
import List from "@components/List.astro";
import ListItem from "@components/ListItem.astro";
import AboutLayout from "@layouts/AboutLayout.astro";
import Item from "@src/components/Item.astro";
import { Icon } from "astro-icon/components";
import { rawContent as SelfDescription } from "../../static/self-description.md";
---

<AboutLayout title="About">
  <Icon name="mdi:search" slot="icon" />
  <List>
    <ListItem title="名前" alwaysCenter>
      <Item value="Mori" />
    </ListItem>
    <ListItem title="年齢" alwaysCenter>
      <Item value="18歳" />
    </ListItem>
    <ListItem title="誕生日" alwaysCenter>
      <Item value="2007/12/18" />
    </ListItem>
  </List>
  <p
    class="container my-2 w-9/10 measure-base rounded-lg border-2 text-responsive-lg line-loose font-semibold text-primary md:w-3/5"
  >
    {SelfDescription()}
  </p>
  <div class="container mb-10 stats-grid pt-2">
    <div class="relative h-[150px] rounded-xs">
      <img
        alt="GitHub Stats"
        src="https://github-stats-extended.vercel.app/api?username=moriyoshi-kasuga&theme=catppuccin_mocha"
        class="object-fit aspect-auto h-[150px]"
        height="100%"
      />
    </div>

    <div
      class="relative order-0 h-[200px] rounded-xs md:order-1 md:max-lg:col-span-2 lg:order-0"
    >
      <img
        alt="Top Langs"
        src="https://github-stats-extended.vercel.app/api/top-langs?username=moriyoshi-kasuga&layout=compact&langs_count=8&theme=catppuccin_mocha"
        class="object-fit aspect-auto h-[200px]"
        height="100%"
      />
    </div>

    <div class="relative h-[150px] rounded-xs">
      <img
        alt="GitHub Streak"
        src="https://streak-stats.demolab.com?user=moriyoshi-kasuga&theme=catppuccin_mocha"
        class="object-fit aspect-auto h-[150px]"
        height="100%"
      />
    </div>
  </div>
</AboutLayout>
