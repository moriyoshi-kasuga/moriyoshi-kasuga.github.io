---
import List from "@components/List.astro";
import ListItem from "@components/ListItem.astro";
import AboutLayout from "@layouts/AboutLayout.astro";
import Item from "@src/components/Item.astro";
import { Icon } from "astro-icon/components";
---

<AboutLayout title="Likes">
  <Icon name="mdi:like-outline" slot="icon" />
  <List class="mb-10">
    <ListItem title="エディター">
      <Item
        href="https://github.com/neovim/neovim"
        value="Neovim"
        skillIcon="neovim"
      />
    </ListItem>
    <ListItem title="テーマ">
      <Item
        href="https://github.com/catppuccin/catppuccin"
        value="Catppuccin Macchiato"
        skillIcon="catppuccin"
      />
    </ListItem>
    <ListItem title="キーボード">
      <Item
        value="ATK 68 V2 S GlacierBlue（US配列）"
        href="https://www.atk.store/products/atk-68-v2-esports-hall-effect-keyboard?variant=46142080024794"
      />
    </ListItem>
    <ListItem title="飲み物">
      <Item value="カフェオレ、緑茶、ウーロン茶" />
    </ListItem>
    <ListItem title="漫画">
      <Item
        href="https://www.sunday-webry.com/episode/3269754496548997914"
        value="葬送のフリーレン"
      />
    </ListItem>
    <ListItem title="フォント">
      <Item
        href="https://github.com/subframe7536/maple-font"
        value="Maple Mono"
      />
    </ListItem>
    <ListItem title="プログラミング言語">
      <Item href="https://www.rust-lang.org/" value="Rust" skillIcon="rust" />
      <Item href="https://www.lua.org/" value="Lua" skillIcon="lua" />
      <Item
        href="https://www.typescriptlang.org/"
        value="TypeScript"
        skillIcon="typescript"
      />
    </ListItem>
    <ListItem title="OS">
      <Item href="https://nixos.org/" value="NixOS" skillIcon="nixos" />
      <Item
        href="https://www.apple.com/macos/"
        value="macOS"
        skillIcon="apple"
      />
    </ListItem>
    <ListItem title="ウィンドウマネージャー">
      <Item href="https://github.com/niri-wm/niri" value="Niri (NixOS)" />
      <Item href="https://github.com/OmniNull/OmniWM" value="OmniWM (macOS)" />
    </ListItem>
    <ListItem title="開発環境">
      <Item value="WezTerm" href="https://wezterm.org" skillIcon="wezterm" />
      <Item value="Neovim" href="https://neovim.io/" skillIcon="neovim" />
      <Item value="tmux" href="https://github.com/tmux/tmux" skillIcon="tmux" />
      <Item value="Fish" href="https://fishshell.com" />
    </ListItem>
  </List>
</AboutLayout>
