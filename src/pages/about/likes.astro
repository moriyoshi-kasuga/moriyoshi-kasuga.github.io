---
import Item from "@components/Item.astro";
import List from "@components/List.astro";
import AboutLayout from "@layouts/AboutLayout.astro";
import { Icon } from "astro-icon/components";
---

<AboutLayout title="Likes" color="text-danger-foreground">
  <Icon name="mdi:like-outline" slot="icon" />
  <List>
    <Item
      id="エディター"
      href="https://github.com/neovim/neovim"
      value="Neovim"
    />
    <Item
      id="テーマ"
      href="https://github.com/folke/tokyonight.nvim"
      value="TokyoNight Night"
    />
    <Item id="キーボード配列" value="US" />
    <Item id="SNS" value="Youtube" />
    <Item id="飲み物" value="カフェラテ, 緑茶, ウーロン茶" />
    <Item id="漫画" value="葬送のフリーレン" />
    <Item
      id="フォント"
      href="https://www.jetbrains.com/lp/mono/"
      value="JetBrains Mono"
    />
  </List>
</AboutLayout>
