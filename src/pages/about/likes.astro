---
import List from "@components/List.astro";
import ListItem from "@components/ListItem.astro";
import AboutLayout from "@layouts/AboutLayout.astro";
import Item from "@src/components/Item.astro";
import { Icon } from "astro-icon/components";
---

<AboutLayout title="Likes" class="text-danger-foreground">
  <Icon name="mdi:like-outline" slot="icon" />
  <List class="mb-10">
    <ListItem title="エディター">
      <Item
        href="https://github.com/neovim/neovim"
        value="Neovim"
        skillIcon="neovim"
      />
    </ListItem>
    <ListItem title="テーマ">
      <Item
        href="https://github.com/catppuccin/nvim"
        value="Catppuccin Mocha"
        skillIcon="catppuccin"
      />
    </ListItem>
    <ListItem title="キーボード">
      <Item
        value="ATK 68 V2 S GlacierBlue（US配列）"
        href="https://www.atk.store/products/atk-68-v2-esports-hall-effect-keyboard?variant=46142080024794"
      />
    </ListItem>
    <ListItem title="飲み物">
      <Item value="カフェオレ、緑茶、ウーロン茶" />
    </ListItem>
    <ListItem title="漫画">
      <Item
        href="https://www.sunday-webry.com/episode/3269754496548997914"
        value="葬送のフリーレン"
      />
    </ListItem>
    <ListItem title="フォント">
      <Item href="https://www.jetbrains.com/lp/mono/" value="JetBrains Mono" />
    </ListItem>
    <ListItem title="プログラミング言語">
      <Item href="https://www.rust-lang.org/" value="Rust" skillIcon="rust" />
      <Item
        href="https://www.typescriptlang.org/"
        value="TypeScript"
        skillIcon="typescript"
      />
    </ListItem>
    <ListItem title="開発環境">
      <Item href="https://nixos.org/" value="Nix" skillIcon="nixos" />
      <Item
        href="https://github.com/catppuccin/nvim"
        value="Catppuccin Mocha"
        skillIcon="catppuccin"
      />
      <Item
        value="bash"
        skillIcon="bash"
        href="https://www.gnu.org/software/bash/"
      />
      <Item value="vim" skillIcon="vim" href="https://www.vim.org/" />
      <Item value="neovim" skillIcon="neovim" href="https://neovim.io/" />
      <Item value="lazyvim" skillIcon="lazyvim" href="https://lazyvim.org/" />
      <Item href="https://github.com/tmux/tmux" value="tmux" skillIcon="tmux" />
    </ListItem>
  </List>
</AboutLayout>
