---
import IconButton from "@components/IconButton.astro";
import AboutLayout from "@layouts/AboutLayout.astro";
import { Icon } from "astro-icon/components";
---

<AboutLayout title="Links" class="text-success-foreground">
  <Icon name="mdi:notebook-outline" slot="icon" />
  <h2 class="my-6 text-3xl font-bold">SNS</h2>
  <div class="flex space-x-2">
    <IconButton url="https://github.com/moriyoshi-kasuga">
      <Icon name="mdi:github" slot="icon" />
      GitHub
    </IconButton>
    <IconButton url="https://twitter.com/MoriyoshiKasuga">
      <Icon name="mdi:twitter" slot="icon" />
      旧Twitter
    </IconButton>
  </div>
  <h2 class="my-6 text-3xl font-bold">サイト</h2>
  <div class="flex space-x-2">
    <IconButton url="https://github.com/moriyoshi-kasuga/moriyoshi-kasuga.github.io">
      <Icon name="mdi:source-branch" slot="icon" />
      リポジトリ
    </IconButton>
  </div>
</AboutLayout>
