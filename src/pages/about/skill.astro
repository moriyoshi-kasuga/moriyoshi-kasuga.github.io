---
import type { Skill } from "../../type";
import AboutLayout from "@layouts/AboutLayout.astro";
import { Icon } from "astro-icon/components";

const skillFiles = import.meta.glob<{ frontmatter: Skill; Content: any }>("../../static/skill/*.md", { eager: true });
const skills = Object.values(skillFiles);
---

<AboutLayout title="Skill" class="text-primary">
  <Icon name="mdi:computer" slot="icon" />
  <p class="text-center text-2xl">
    完全に自分の主観でどれぐらい理解できるかを図で表しています
  </p>
  <div
    id="techContent"
    class="container my-4 flex flex-wrap items-center justify-center"
  >
    {
      skills.map((skill) => {
        return (
          <div class="mb-12 flex flex-col w-full items-center lg:flex-row md:w-1/2">
            <div
              class="techStack font-monospace relative flex aspect-square w-1/2 items-center justify-center rounded-full"
              style={{
                ["--learn" as string]: skill.frontmatter.learn,
              }}
            >
              <h3 class="text-2xl font-semibold">{skill.frontmatter.title}</h3>
              <p class="absolute top-[30%] -translate-y-1/2 text-xl font-semibold">
                {skill.frontmatter.learn}%
              </p>
            </div>
            <div class="jusify-center flex w-4/5 flex-col items-center px-4 py-2">
              <skill.Content />
            </div>
          </div>
        );
      })
    }
    <style>
      #techContent :global(a) {
        color: var(--color-link);
        text-decoration: none;
      }
      #techContent :global(blockquote) {
        border-left: 4px solid var(--color-gray-300);
        margin: 0.5em 0;
        padding: 0.5em 0.3em;
        color: var(--color-link);
        background: var(--color-gray-50);
      }
    </style>
  </div>
</AboutLayout>
<style>
  @keyframes skillProgress {
    from {
      --percent: 0;
    }
    to {
      --percent: var(--learn);
    }
  }

  .techStack {
    --learn: 0;
    --percent: 0;
    animation: skillProgress var(--duration-extra-slow) var(--ease-out) forwards;
    background-image: conic-gradient(
      var(--color-primary),
      var(--color-primary) calc(var(--percent) * 1%),
      var(--color-gray-500) calc(var(--percent) * 1%) 100%
    );
    will-change: background-image;
  }

  @media (prefers-reduced-motion: reduce) {
    .techStack {
      animation: none;
      --percent: var(--learn);
    }
  }
</style>
