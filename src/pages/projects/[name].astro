---
import type { Project } from "@src/type";
import type { ImageMetadata } from "astro";
import ProjectLink from "@components/ProjectLink.astro";
import Layout from "@layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

type Type = {
  params: {
    name: string;
  };
  props: {
    project: { frontmatter: Project; Content: any };
  };
}[];

export async function getStaticPaths(): Promise<Type> {
  const projectFiles = import.meta.glob<{ frontmatter: Project; Content: any }>("../../static/projects/*.md", { eager: true });

  return Object.values(projectFiles).map((project) => {
    return {
      params: {
        name: project.frontmatter.name,
      },
      props: {
        project,
      },
    };
  });
}

const {
  project: { frontmatter, Content },
} = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>("/src/assets/**/*");
---

<Layout title={frontmatter.title}>
  <h1 class="my-2 text-center text-5xl font-semibold">
    {frontmatter.title}
  </h1>
  <p class="text-center text-lg">{frontmatter.description}</p>
  <div class="mt-5 flex flex-col justify-center gap-x-8 gap-y-4 sm:flex-row md:mt-8">
    <div class="flex items-center p-4 md:justify-center">
      <div class="group relative ml-auto">
        <div
          class="flex cursor-pointer items-center justify-center rounded-b-md bg-black p-2 text-xl shadow-xl duration-300 hover:shadow-2xl md:rounded-full"
        >
          <Icon name="mdi:source-branch" class="text-white" />
        </div>
        <div
          class="absolute -top-9 z-10 flex w-40 rounded-t-md rounded-br-md bg-black p-2 text-center text-sm break-keep text-white duration-150 group-hover:visible group-hover:scale-100 group-hover:opacity-100 md:invisible md:w-fit md:-translate-x-1/4 md:scale-80 md:justify-center md:rounded-xl md:px-1.5 md:py-1 md:opacity-0"
        >
          <p>公開日</p>
        </div>
      </div>
      <p class="mt-2 ml-2 max-sm:w-1/2 md:mt-0">{frontmatter.createdAt}</p>
    </div>
    <div class="flex items-center p-4 md:justify-center">
      <div class="group relative ml-auto">
        <div
          class="flex cursor-pointer items-center justify-center rounded-b-md bg-black p-2 text-xl shadow-xl duration-300 hover:shadow-2xl md:rounded-full"
        >
          <Icon name="mdi:category" class="text-white" />
        </div>
        <div
          class="absolute -top-9 z-10 flex w-40 rounded-t-md rounded-br-md bg-black p-2 text-center text-sm break-keep text-white duration-150 group-hover:visible group-hover:scale-100 group-hover:opacity-100 md:invisible md:w-fit md:-translate-x-1/4 md:scale-80 md:justify-center md:rounded-xl md:px-1.5 md:py-1 md:opacity-0"
        >
          <p>ジャンル</p>
        </div>
      </div>
      <p class="mt-2 ml-2 max-sm:w-1/2 md:mt-0">{frontmatter.genre}</p>
    </div>
  </div>
  <div class="flex flex-wrap justify-center gap-8">
    <ProjectLink url={frontmatter.github} title="Code">
      <Icon name="mdi:github" />
    </ProjectLink>
    <ProjectLink url={frontmatter.site} title="Site">
      <Icon name="mdi:link-variant" />
    </ProjectLink>
  </div>
  <div
    class="h-divider bg-divider relative mx-auto my-8 h-[1px] w-11/12 border-none"
  >
    <h2
      class="absolute left-[50%] -translate-x-1/2 -translate-y-1/2 justify-center bg-white text-center text-3xl"
    >
      技術
    </h2>
  </div>
  <div class="container mx-auto my-5">
    <div class="flex flex-wrap justify-center">
      {
        frontmatter.technology.map((str) => {
          return <p class="m-1 p-1">{str}</p>;
        })
      }
    </div>
    <div class="my-16 flex flex-wrap items-stretch justify-center gap-y-4">
      <div class="w-full md:w-1/2 lg:w-1/3">
        <div
          class="border-success-foreground relative m-2 flex h-full border-2 border-dotted"
        >
          <p class="my-auto p-4">{frontmatter.objective}</p>
          <h3 class="absolute -top-6 left-4 rounded-xl bg-white p-2 text-lg">
            目的
          </h3>
        </div>
      </div>
      <div class="w-full md:w-1/2 lg:w-1/3">
        <div
          class="border-warning-foreground relative m-2 flex h-full border-2 border-dotted"
        >
          <p class="my-auto p-4">{frontmatter.background}</p>
          <h3 class="absolute -top-6 left-4 rounded-xl bg-white p-2 text-lg">
            背景
          </h3>
        </div>
      </div>
      <div class="w-full md:w-1/2 lg:w-1/3">
        <div
          class="border-primary-foreground relative m-2 flex h-full border-2 border-dotted"
        >
          <p class="my-auto p-4">{frontmatter.commitment}</p>
          <h3 class="absolute -top-6 left-4 rounded-xl bg-white p-2 text-lg">
            こだわり
          </h3>
        </div>
      </div>
    </div>
    <div class="w-full rounded-xl px-4 pt-2 pb-4 text-responsive-lg break-words shadow-lg md:px-8 lg:px-12 xl:px-24 line-loose">
      <Content />
    </div>
    <div
      class="relative m-4 mt-20 mb-40 rounded-xl border-2 border-double border-black"
    >
      <div class="absolute inset-x-0 -top-6 flex justify-center">
        <h3 class="rounded-2xl bg-white px-4 text-center text-2xl">
          ギャラリー
        </h3>
      </div>
      <div class="gallery-grid">
        {
          frontmatter.gallery?.map(async (path) => {
            // TODO: add image popup
            return (
              <Image
                src={images[
                  `/src/assets/projects/${frontmatter.name}/${path}`
                ]()}
                alt={path}
                class="relative! aspect-auto object-contain"
                loading="lazy"
                widths={[320, 640, 960, 1280]}
                sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
              />
            );
          })
        }
      </div>
    </div>
  </div>
</Layout>
