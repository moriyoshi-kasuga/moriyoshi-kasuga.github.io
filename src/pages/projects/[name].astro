---
import type { CollectionEntry } from "astro:content";
import LabeledDottedCard from "@components/LabeledDottedCard.astro";
import LinkButton from "@components/LinkButton.astro";
import Tooltip from "@components/Tooltip.astro";
import ZoomDialog from "@components/ZoomDialog.astro";
import Layout from "@layouts/Layout.astro";
import { formatDate } from "@src/lib/date";
import { getSortedProjects } from "@src/lib/projects";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { render } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

export async function getStaticPaths() {
  const projects = await getSortedProjects();

  return projects.map((project) => ({
    params: { name: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data: frontmatter } = project;
const { Content } = await render(project);
---

<Layout title={frontmatter.title}>
  <h1 class="my-2 text-center text-5xl font-semibold">
    {frontmatter.title}
  </h1>
  <p class="text-center text-lg">{frontmatter.description}</p>
  <div
    class="mt-5 flex flex-col justify-center gap-x-8 gap-y-4 max-md:pr-15 sm:flex-row md:pr-10"
  >
    <Tooltip details="公開日">
      <Icon name="mdi:source-branch" class="text-white" slot="icon" />
      {formatDate(frontmatter.createdAt)}
    </Tooltip>
    <Tooltip details="ジャンル">
      <Icon name="mdi:category" class="text-white" slot="icon" />
      {frontmatter.genre}
    </Tooltip>
  </div>
  <div class="flex flex-wrap justify-center gap-8">
    <LinkButton url={frontmatter.github}>
      <Icon name="mdi:github" slot="icon" />
      Code
    </LinkButton>
    <LinkButton url={frontmatter.site}>
      <Icon name="mdi:link-variant" slot="icon" />
      Site
    </LinkButton>
  </div>
  <div class="relative mx-auto my-8 h-px w-11/12 border-none bg-divider">
    <h2
      class="absolute left-[50%] -translate-1/2 justify-center bg-white text-center text-3xl"
    >
      技術
    </h2>
  </div>
  <div class="container-center my-5">
    <div class="flex flex-wrap justify-center gap-2 text-lg">
      {frontmatter.technology.map((str) => <span class="tech-tag">{str}</span>)}
    </div>
    <div class="my-16 flex flex-wrap items-stretch justify-center gap-y-4">
      <LabeledDottedCard label="目的" accent="success">
        {frontmatter.objective}
      </LabeledDottedCard>
      <LabeledDottedCard label="背景" accent="warning">
        {frontmatter.background}
      </LabeledDottedCard>
      <LabeledDottedCard label="こだわり" accent="primary">
        {frontmatter.commitment}
      </LabeledDottedCard>
    </div>
    <div
      class="w-full rounded-xl px-4 pt-2 pb-4 text-responsive-lg line-loose wrap-break-word shadow-lg md:px-8 lg:px-12 xl:px-24"
    >
      <Content />
    </div>
    <div
      class="relative m-4 mt-20 mb-40 rounded-xl border-2 border-double border-black"
    >
      <div class="absolute inset-x-0 -top-6 flex justify-center">
        <h3 class="rounded-2xl bg-white px-4 text-center text-2xl">
          ギャラリー
        </h3>
      </div>
      <div class="gallery-grid">
        {
          frontmatter.gallery.map((image) => (
            <ZoomDialog>
              <Image
                loading="lazy"
                src={image}
                alt={frontmatter.title}
                class="aspect-auto object-contain"
                widths={[320, 640, 960, 1280]}
                sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
              />
            </ZoomDialog>
          ))
        }
      </div>
    </div>
  </div>
</Layout>
