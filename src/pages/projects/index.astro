---
import Layout from "@layouts/Layout.astro";
import { formatDate } from "@src/lib/date";
import { getSortedProjects } from "@src/lib/projects";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

const projects = await getSortedProjects();
---

<Layout title="Projects">
  <div class="min-h-all pb-10">
    <h1 class="text-danger flex justify-center gap-x-2 text-5xl font-bold">
      <Icon name="mdi:source-branch" />
      Projects
    </h1>
    <div class="container-center my-8 responsive-grid">
      {
        projects.map((project) => (
          <a href={`/projects/${project.id}`} class="project-card">
            <h2 class="text-center text-2xl font-semibold">
              {project.data.pin && (
                <Icon
                  name="mdi:pin"
                  class="inline-block text-danger"
                  title="ピン留めされたプロジェクト"
                />
              )}
              {project.data.title}
            </h2>
            <div class="relative my-2 aspect-video w-full">
              <Image
                loading="lazy"
                src={project.data.gallery[0]}
                alt={project.data.title}
                class="rounded-xl object-cover"
              />
            </div>
            <div class="flex flex-wrap items-start gap-2 text-lg">
              {project.data.technology.map(tag => (
                <span class="tech-tag">{tag}</span>
              ))}
            </div>
            <div class="py-2 text-xl break-words">
              {project.data.description}
            </div>
            <span class="mt-auto ml-auto font-thin">
              {formatDate(project.data.createdAt)}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</Layout>
