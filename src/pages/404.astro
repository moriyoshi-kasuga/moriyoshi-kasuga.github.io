---
import LinkButton from "@components/LinkButton.astro";
import Layout from "@layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Page not found">
  <div class="container mx-auto flex min-h-all items-center px-6 py-12">
    <div class="mx-auto flex max-w-sm flex-col items-center text-center">
      <p
        class="rounded-full bg-primary-300 p-3 text-3xl font-medium text-primary-500"
      >
        <Icon name="mdi:warning-decagram-outline" />
      </p>
      <h1 class="mt-3 text-2xl font-semibold text-gray-800 md:text-3xl">
        Page not found
      </h1>
      <p class="my-4 text-gray-500">お探しのページは存在しません。</p>
      <LinkButton url="/" variant="dark" self>
        <Icon name="mdi:arrow-left-thin" slot="icon" />
        Go back
      </LinkButton>
    </div>
  </div>
</Layout>
